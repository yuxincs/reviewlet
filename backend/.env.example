# Export these values in your shell; the server does not load .env files.
OPENAI_API_KEY=replace-with-your-api-key
# Optional: override the default with a model supporting Structured Outputs.
OPENAI_MODEL=gpt-6.1-sol
# Optional: OpenAI-compatible base URL, including the API version prefix.
OPENAI_BASE_URL=https://api.openai.com/v1
REVIEW_TIMEOUT=90s
OPENAI_MAX_COMPLETION_TOKENS=16384
LISTEN_ADDR=:8080
LOG_LEVEL=info

# Relative to the backend working directory when using make backend-run.
DATABASE_PATH=data/reviewlet.db
